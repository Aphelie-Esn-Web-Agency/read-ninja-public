msgstr "Apenas mobile (oculto no desktop)"

#: includes/class-settings.php:412
msgid "Masqué sur mobile"
msgstr "Oculto no mobile"

#: includes/class-settings.php:424
msgid "Breakpoint mobile : largeur < 768px"
msgstr "Breakpoint mobile: largura < 768px"

#: includes/class-settings.php:431
msgid "Hauteur de l'article"
msgstr "Altura do artigo"

#: includes/class-settings.php:432
msgid "Hauteur de la page"
msgstr "Altura da página"

#: includes/class-settings.php:442
msgid "« Hauteur de l'article » mesure la progression sur le contenu uniquement, « Hauteur de la page » sur l'ensemble de la page."
msgstr "«Altura do artigo» mede o progresso apenas no conteúdo, «Altura da página» na página inteira."

#: includes/class-settings.php:473
msgid "Aucun"
msgstr "Nenhum"

#: includes/class-settings.php:474
msgid "Pourcentage"
msgstr "Percentagem"

#: includes/class-settings.php:475
msgid "Temps restant"
msgstr "Tempo restante"

#: includes/class-settings.php:476
msgid "Les deux"
msgstr "Ambos"

#: includes/class-settings.php:487
msgid "ou"
msgstr "ou"

#: includes/class-settings.php:495
msgid "Flottant dans la barre"
msgstr "Flutuante na barra"

#: includes/class-settings.php:496
msgid "À gauche"
msgstr "À esquerda"

#: includes/class-settings.php:497
msgid "À droite"
msgstr "À direita"

#: includes/class-settings.php:509
msgid "« Flottant » suit le bord de la barre remplie. « Gauche » et « Droite » fixent l'indicateur aux extrémités."
msgstr "«Flutuante» segue a borda da barra preenchida. «Esquerda» e «Direita» fixam o indicador nas extremidades."

#: includes/class-settings.php:527
msgid "Taille fixe"
msgstr "Tamanho fixo"

#: includes/class-settings.php:538
msgid "« Automatique » adapte la taille du texte à la hauteur de la barre. « Taille fixe » applique une valeur en pixels (8–32)."
msgstr "«Automático» adapta o tamanho do texto à altura da barra. «Tamanho fixo» aplica um valor em píxeis (8–32)."

#: includes/class-settings.php:572
msgid "Couleur fixe"
msgstr "Cor fixa"

#: includes/class-settings.php:582
msgid "« Automatique » adapte la couleur du texte en fonction de l'arrière-plan pour rester lisible."
msgstr "«Automático» adapta a cor do texto em função do fundo para se manter legível."

#: includes/class-settings.php:622
msgid "Moyenne adulte : 200 mots/min"
msgstr "Média adulta: 200 palavras/min"

#: includes/class-settings.php:638
msgid "Minutes uniquement"
msgstr "Apenas minutos"

#: includes/class-settings.php:642
msgid "Minutes et secondes"
msgstr "Minutos e segundos"

#: includes/class-settings.php:654
msgid "Texte affiché avant le temps. Exemple : « Encore » → « Encore 3 min restantes »."
msgstr "Texto mostrado antes do tempo. Exemplo: «Ainda» → «Ainda 3 min restantes»."

#: includes/class-settings.php:663
msgid "Texte affiché après le temps. Exemple : « min restantes »."
msgstr "Texto mostrado depois do tempo. Exemplo: «min restantes»."

