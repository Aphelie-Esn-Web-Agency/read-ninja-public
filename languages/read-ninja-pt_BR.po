#: includes/class-settings.php:370
#: includes/class-settings.php:521
#: includes/class-settings.php:566
msgid "Automatique"
msgstr "Automático"

#: includes/class-settings.php:376
msgid "Valeur fixe"
msgstr "Valor fixo"

#: includes/class-settings.php:387
msgid "« Automatique » détecte la hauteur du header fixe/sticky de votre thème. « Valeur fixe » applique un décalage en pixels."
msgstr "«Automático» deteta a altura do header fixo/sticky do seu tema. «Valor fixo» aplica um deslocamento em píxeis."

#: includes/class-settings.php:409
msgid "Tous les appareils"
msgstr "Todos os dispositivos"

#: includes/class-settings.php:410
msgid "Desktop uniquement (masqué sur mobile)"
msgstr "Apenas desktop (oculto no mobile)"

#: includes/class-settings.php:411
