msgstr "Artikelhöhe"

#: includes/class-settings.php:432
msgid "Hauteur de la page"
msgstr "Seitenhöhe"

#: includes/class-settings.php:442
msgid "« Hauteur de l'article » mesure la progression sur le contenu uniquement, « Hauteur de la page » sur l'ensemble de la page."
msgstr "„Artikelhöhe“ misst den Fortschritt nur am Inhalt, „Seitenhöhe“ über die gesamte Seite."

#: includes/class-settings.php:473
msgid "Aucun"
msgstr "Keine"

#: includes/class-settings.php:474
msgid "Pourcentage"
msgstr "Prozentsatz"

