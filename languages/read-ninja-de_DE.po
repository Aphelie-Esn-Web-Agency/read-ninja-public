#: includes/class-settings.php:487
msgid "ou"
msgstr "oder"

#: includes/class-settings.php:495
msgid "Flottant dans la barre"
msgstr "Schwebend im Balken"

#: includes/class-settings.php:496
msgid "À gauche"
msgstr "Links"

#: includes/class-settings.php:497
msgid "À droite"
msgstr "Rechts"

#: includes/class-settings.php:509
msgid "« Flottant » suit le bord de la barre remplie. « Gauche » et « Droite » fixent l'indicateur aux extrémités."
msgstr "„Schwebend“ folgt dem Rand des gefüllten Balkens. „Links“ und „Rechts“ fixieren die Anzeige an den Enden."

#: includes/class-settings.php:527
msgid "Taille fixe"
msgstr "Feste Größe"

#: includes/class-settings.php:538
msgid "« Automatique » adapte la taille du texte à la hauteur de la barre. « Taille fixe » applique une valeur en pixels (8–32)."
msgstr "„Automatisch“ passt die Textgröße an die Balkenhöhe an. „Feste Größe“ wendet einen Pixelwert an (8–32)."

#: includes/class-settings.php:572
msgid "Couleur fixe"
msgstr "Feste Farbe"

#: includes/class-settings.php:582
msgid "« Automatique » adapte la couleur du texte en fonction de l'arrière-plan pour rester lisible."
msgstr "„Automatisch“ passt die Textfarbe an den Hintergrund an, um lesbar zu bleiben."

#: includes/class-settings.php:622
msgid "Moyenne adulte : 200 mots/min"
msgstr "Erwachsenen-Durchschnitt: 200 Wörter/Min."

#: includes/class-settings.php:638
msgid "Minutes uniquement"
msgstr "Nur Minuten"

#: includes/class-settings.php:642
msgid "Minutes et secondes"
msgstr "Minuten und Sekunden"

#: includes/class-settings.php:654
msgid "Texte affiché avant le temps. Exemple : « Encore » → « Encore 3 min restantes »."
msgstr "Text vor der Zeit. Beispiel: „Noch“ → „Noch 3 Min. verbleibend“."

#: includes/class-settings.php:663
msgid "Texte affiché après le temps. Exemple : « min restantes »."
msgstr "Text nach der Zeit. Beispiel: „Min. verbleibend“."

